Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: DBeaver Auto Theme Plugin
Bundle-SymbolicName: com.dbeaver.plugin.autotheme;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Activator: com.dbeaver.plugin.autotheme.Activator
